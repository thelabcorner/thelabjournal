# Release discovery must not depend on stale HTTP caches. Workbox retains the
# offline shell independently in CacheStorage.
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-store, max-age=0

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# Vite content-hashed assets are immutable across deployments.
/assets/*
  Cache-Control: public, max-age=31536000, immutable