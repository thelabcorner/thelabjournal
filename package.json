{
  "name": "thelabjournal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/sync-silica-post.mjs && vite --host 0.0.0.0",
    "build": "bun scripts/sync-silica-post.mjs && bun run generate:og && tsc --noEmit && vite build && bun scripts/article-social.mjs pages && bun scripts/article-social.mjs audit",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "export:essay": "bun scripts/export-essay.ts",
    "smoke": "bun scripts/smoke.mjs",
    "audit:dither": "bun scripts/dither-audit.mjs",
    "audit:visual": "bun scripts/visual-audit.mjs",
    "audit:chrome": "bun scripts/chrome-audit.mjs",
    "audit:spotlight": "bun scripts/spotlight-audit.ts",
    "audit:mobile-sections": "bun scripts/mobile-section-menu-audit.mjs",
    "audit:manuscript-progress": "bun scripts/manuscript-sticky-progress-audit.mjs",
    "audit:share": "bun scripts/native-share-audit.mjs",
    "audit:shell": "bun scripts/shell-alignment-audit.mjs",
    "audit:theme-haptics": "bun scripts/theme-haptics-audit.mjs",
    "audit:appearance": "bun scripts/appearance-audit.mjs",
    "generate:pwa-icons": "bun scripts/create-pwa-icons.mjs",
    "generate:og": "bun scripts/generate-og.mjs && bun scripts/article-social.mjs generate",
    "audit:og": "bun scripts/og-audit.mjs && bun scripts/article-social.mjs audit && bun scripts/article-social.mjs audit-determinism",
    "audit:icons": "bun scripts/icon-audit.mjs",
    "audit:pwa": "bun scripts/pwa-audit.mjs",
    "audit:virtualization": "bun scripts/virtualization-audit.mjs && bun scripts/virtual-navigation-audit.mjs && bun scripts/virtual-pane-audit.mjs && bun scripts/virtual-resize-audit.mjs && bun scripts/navigation-virtual-regression.mjs",
    "audit:virtual-cold": "bun scripts/virtual-cold-load-audit.mjs",
    "bench:virtualization": "bun scripts/virtualization-bench.mjs",
    "audit:virtual-pwa": "bun scripts/virtual-pwa-offline-audit.mjs",
    "audit:archive": "bun scripts/archive-sort-audit.mjs",
    "audit:archive-default": "bun scripts/archive-default-audit.mjs",
    "audit:landing-dither": "bun scripts/landing-dither-audit.mjs",
    "sync:journal": "bun scripts/sync-silica-post.mjs",
    "check:journal": "bun scripts/sync-silica-post.mjs --check",
    "audit:article-http": "bun scripts/article-http-audit.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/katex": "^0.16.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "katex": "^0.16.38",
    "lucide-react": "^0.544.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright-core": "^1.64.0",
    "satori": "^0.47.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
